---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { talkBySlug, talkStatus } from '../../data/talks';
import { renderBlocks } from '../../data/content';
import { formatFullDate } from '../../utils/datetime';
import { MapPin } from '../../components/ui/icons/index';
import TalkStatusBadge from '../../components/portfolio/TalkStatusBadge.astro';

const { slug } = Astro.params;
const talk = talkBySlug(slug ?? '');

let html = '';
if (talk) {
	html = await renderBlocks(talk.body, 'talks');
}

const fm = talk?.frontmatter;
const status = talk ? talkStatus(talk) : 'past';
const date = fm ? formatFullDate(fm.date) : '';
---

<SiteLayout title={talk ? `${fm?.title} — Talk` : 'Talk not found'}>
	{
		talk && fm ? (
			<article class="mx-auto max-w-3xl px-6 pb-24 pt-12">
				<a href="/talks" class="mb-6 inline-flex items-center gap-1 font-mono text-xs text-accent hover:underline">
					← All talks
				</a>

				<header class="mb-10">
					<div class="mb-4 flex flex-wrap items-center gap-3">
						<TalkStatusBadge status={status} />
						<time class="font-mono text-sm text-muted-foreground" datetime={fm.date}>
							{date}
						</time>
					</div>

					<h1 class="text-glow-pink font-heading text-3xl font-extrabold leading-tight tracking-tight md:text-4xl">
						{fm.title}
					</h1>

					{fm.event.length > 0 && (
						<p class="mt-3 font-mono text-sm text-accent">
							{fm.event_url.length > 0 ? (
								<a href={fm.event_url} target="_blank" rel="noreferrer" class="hover:underline">
									{fm.event}
								</a>
							) : (
								fm.event
							)}
						</p>
					)}

					{fm.location.length > 0 && (
						<p class="mt-2 inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground">
							<MapPin class="size-3.5 text-primary" />
							{fm.venue.length > 0 ? `${fm.venue}, ${fm.location}` : fm.location}
						</p>
					)}
				</header>

				<div class="prose-content" set:html={html} />

				{fm.tags.length > 0 && (
					<div class="mt-10 flex flex-wrap gap-2 border-t border-border pt-6">
						{fm.tags.map((tag) => (
							<span class="inline-flex items-center rounded-md border border-border bg-secondary px-2 py-0.5 font-mono text-xs text-secondary-foreground">
								#{tag}
							</span>
						))}
					</div>
				)}
			</article>
		) : (
			<div class="flex items-center justify-center py-24">
				<div class="text-center">
					<h1 class="font-heading text-2xl text-foreground">Talk not found</h1>
					<p class="mt-2 text-muted-foreground">The talk you're looking for doesn't exist.</p>
					<a href="/talks" class="mt-6 inline-block text-neon-cyan hover:underline">
						Back to talks
					</a>
				</div>
			</div>
		)
	}
</SiteLayout>
