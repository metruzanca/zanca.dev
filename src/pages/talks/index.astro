---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { allTalks, upcomingTalks, pastTalks } from '../../data/talks';
import TalkCard from '../../components/portfolio/TalkCard.astro';

const total = allTalks().length;
const upcoming = upcomingTalks();
const past = pastTalks();
---

<SiteLayout title="Talks — Sam Zanca">
	<main class="mx-auto max-w-3xl px-4 pb-12 pt-14 md:pt-20">
		<h1 class="mb-2 font-display text-3xl font-extrabold uppercase text-foreground md:text-4xl">
			Talks
		</h1>
		<p class="mb-8 text-sm leading-relaxed text-muted-foreground">
			Conference talks on languages, tooling, and the strange places software ends up running.
		</p>

		{
			total === 0 && (
				<p class="font-mono text-sm text-muted-foreground">No talks announced yet. Check back soon.</p>
			)
		}

		{
			upcoming.length > 0 && (
				<>
					<h2 class="mb-4 font-display text-xl font-semibold uppercase text-primary md:text-2xl">
						Upcoming
					</h2>
					<div class="mb-12 grid grid-cols-1 gap-4">
						{upcoming.map((talk) => <TalkCard talk={talk} />)}
					</div>
				</>
			)
		}

		{
			past.length > 0 && (
				<>
					<h2 class="mb-4 font-display text-xl font-semibold uppercase text-muted-foreground md:text-2xl">
						Past
					</h2>
					<div class="grid grid-cols-1 gap-4">
						{past.map((talk) => <TalkCard talk={talk} />)}
					</div>
				</>
			)
		}

		<footer class="mt-12 border-t border-border px-4 py-8">
			<div class="flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
				<p class="font-mono text-xs text-muted-foreground">
					<span class="text-primary">$</span>
					{" built with synthwave — © 2026 Sam"}
				</p>
			</div>
		</footer>
	</main>
</SiteLayout>
