---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { labBySlug } from '../../components/labs/registry';
import WordCount from '../../components/labs/WordCount';
import Timezones from '../../components/labs/Timezones';

const { slug } = Astro.params;
const lab = labBySlug(slug ?? '');
---

<SiteLayout title={lab ? `${lab.meta.name} — Labs` : 'Lab not found'}>
	<main class="mx-auto max-w-3xl px-4 pb-12 pt-14 md:pt-20">
		{
			lab ? (
				<>
					<a href="/labs" class="mb-6 inline-flex items-center gap-1 font-mono text-xs text-accent hover:underline">
						← All Labs
					</a>
					<h1 class="mb-2 font-display text-3xl font-extrabold uppercase text-foreground md:text-4xl">
						{lab.meta.name}
					</h1>
					<p class="mb-8 text-sm leading-relaxed text-muted-foreground">{lab.meta.description}</p>
					<div class="rounded-xl border border-border bg-card p-6">
						{slug === 'word-count' && <WordCount client:only="solid" />}
						{slug === 'tz' && <Timezones client:only="solid" />}
					</div>
				</>
			) : (
				<>
					<h1 class="mb-4 font-display text-3xl font-extrabold uppercase text-foreground md:text-4xl">
						Lab not found
					</h1>
					<p class="mb-6 text-muted-foreground">No lab with that slug exists.</p>
					<a href="/labs" class="font-mono text-sm text-accent hover:underline">← Back to Labs</a>
				</>
			)
		}

		<footer class="mt-12 border-t border-border px-4 py-8">
			<div class="flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
				<p class="font-mono text-xs text-muted-foreground">
					<span class="text-primary">$</span>
					{" built with synthwave — © 2026 Sam"}
				</p>
			</div>
		</footer>
	</main>
</SiteLayout>
