---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { labs } from '../../components/labs/registry';

function tagAccent(index: number): string {
	return index % 2 === 0 ? 'primary' : 'cyan';
}

function tagClasses(accent: string): string {
	return accent === 'cyan'
		? 'rounded-full border px-2.5 py-0.5 font-mono text-[0.65rem] border-accent/40 text-accent'
		: 'rounded-full border px-2.5 py-0.5 font-mono text-[0.65rem] border-primary/40 text-primary';
}
---

<SiteLayout title="Labs — Sam Zanca">
	<main class="mx-auto max-w-3xl px-4 pb-12 pt-14 md:pt-20">
		<h1 class="mb-2 font-display text-3xl font-extrabold uppercase text-foreground md:text-4xl">
			Labs
		</h1>
		<p class="mb-8 text-sm leading-relaxed text-muted-foreground">
			Small tools, experiments, and utilities built with astro &amp; solidjs.
		</p>

		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
			{
				labs.map((lab) => {
					const tags = lab.meta.tags.slice(0, 4);
					return (
						<a
							href={`/labs/${lab.meta.slug}`}
							class="group relative flex flex-col rounded-xl border border-border bg-card p-5 transition-colors hover:border-accent/50"
						>
							<div class="flex items-start justify-between gap-3">
								<h3 class="font-display text-lg font-bold uppercase tracking-tight text-foreground transition-colors group-hover:text-accent">
									{lab.meta.name}
								</h3>
							</div>

							<p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{lab.meta.description}</p>

							{tags.length > 0 && (
								<div class="mt-4 flex flex-wrap gap-1.5">
									{tags.map((tag, i) => (
										<span class={tagClasses(tagAccent(i))}>{tag}</span>
									))}
								</div>
							)}
						</a>
					);
				})
			}
		</div>

		<footer class="mt-12 border-t border-border px-4 py-8">
			<div class="flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
				<p class="font-mono text-xs text-muted-foreground">
					<span class="text-primary">$</span>
					{" built with synthwave — © 2026 Sam"}
				</p>
			</div>
		</footer>
	</main>
</SiteLayout>
