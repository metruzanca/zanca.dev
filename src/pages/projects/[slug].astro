---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projectBySlug } from '../../data/projects';
import { renderBlocks } from '../../data/content';

const { slug } = Astro.params;
const project = projectBySlug(slug ?? '');

let html = '';
if (project) {
	html = await renderBlocks(project.body, 'projects');
}
---

<SiteLayout title={project ? project.frontmatter.title : 'Case study not found'}>
	{
		project ? (
			<article class="mx-auto max-w-3xl px-6 pb-24 pt-12">
				<a href="/projects" class="mb-6 inline-flex items-center gap-1 font-mono text-xs text-accent hover:underline">
					← All Projects
				</a>

				<header class="mb-12">
					<time class="mb-3 block font-mono text-sm text-muted-foreground" datetime={project.frontmatter.timestamp}>
						{project.frontmatter.timestamp.split('T')[0] ?? project.frontmatter.timestamp}
					</time>

					<h1 class="text-glow-pink font-heading text-4xl font-extrabold leading-tight tracking-tight">
						{project.frontmatter.title}
					</h1>

					{project.frontmatter.company && (
						<p class="mt-2 font-mono text-sm text-accent">{project.frontmatter.company}</p>
					)}

					{project.frontmatter.github.length > 0 && (
						<a
							href={project.frontmatter.github}
							target="_blank"
							rel="noreferrer"
							class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-4 py-2 font-mono text-xs text-muted-foreground transition-colors hover:border-accent hover:text-accent"
						>
							View source on GitHub →
						</a>
					)}

					{project.frontmatter.tags.length > 0 && (
						<div class="mt-6 flex flex-wrap gap-2">
							{project.frontmatter.tags.map((tag) => (
								<span class="inline-flex items-center rounded-md border border-border bg-secondary px-2 py-0.5 font-mono text-xs text-secondary-foreground">
									#{tag}
								</span>
							))}
						</div>
					)}
				</header>

				<div class="prose-content" set:html={html} />
			</article>
		) : (
			<div class="flex items-center justify-center py-24">
				<div class="text-center">
					<h1 class="font-heading text-2xl text-foreground">Case study not found</h1>
					<p class="mt-2 text-muted-foreground">The case study you're looking for doesn't exist.</p>
					<a href="/projects" class="mt-6 inline-block text-neon-cyan hover:underline">
						Back to projects
					</a>
				</div>
			</div>
		)
	}
</SiteLayout>
