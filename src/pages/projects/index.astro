---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { githubCache } from '../../data/github';
import { allProjects } from '../../data/projects';
import ProjectCard from '../../components/portfolio/ProjectCard.astro';
import CaseStudyCard from '../../components/portfolio/CaseStudyCard.astro';

const snapshot = githubCache.get();
const repos = snapshot?.all ?? [];
const caseStudies = allProjects();
---

<SiteLayout title="Projects — Sam Zanca">
	<main class="mx-auto max-w-3xl px-4 pb-12 pt-14 md:pt-20">
		<h1 class="mb-8 font-display text-3xl font-extrabold uppercase text-foreground md:text-4xl">
			Projects
		</h1>

		{caseStudies.length > 0 && (
			<>
				<h2 class="mb-4 font-display text-xl font-semibold uppercase text-accent md:text-2xl">
					Case Studies
				</h2>
				<div class="mb-12 grid grid-cols-1 gap-4">
					{caseStudies.map((project) => <CaseStudyCard project={project} />)}
				</div>
			</>
		)}

		<h2 class="mb-4 font-display text-xl font-semibold uppercase text-primary md:text-2xl">
			Open Source
		</h2>
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
			{repos.map((repo) => <ProjectCard repo={repo} />)}
		</div>

		<footer class="mt-12 border-t border-border px-4 py-8">
			<div class="flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
				<p class="font-mono text-xs text-muted-foreground">
					<span class="text-primary">$</span>
					{" built with synthwave — © 2026 Sam"}
				</p>
			</div>
		</footer>
	</main>
</SiteLayout>
