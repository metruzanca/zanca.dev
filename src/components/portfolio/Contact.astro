---
import { Calendar, GitBranch, LinkedIn, Mail, X } from '../ui/icons/index';

const CHANNELS = [
	{
		label: 'calendar',
		handle: 'schedule a chat',
		href: 'https://cal.com/samzanca/15min',
		Icon: Calendar,
	},
	{
		label: 'linkedin',
		handle: '@samuele-zanca',
		href: 'https://linkedin.com/in/samuele-zanca',
		Icon: LinkedIn,
	},
	{
		label: 'x',
		handle: '@metruzanca',
		href: 'https://x.com/metruzanca',
		Icon: X,
	},
	{
		label: 'github',
		handle: '@metruzanca',
		href: 'https://github.com/metruzanca',
		Icon: GitBranch,
	},
	{
		label: 'email',
		handle: 'sam(at)zanca.dev',
		href: '',
		Icon: Mail,
	},
];
---

<section id="contact" class="px-4 py-12">
	<div class="rounded-xl border border-border bg-card p-6 md:p-8">
		<h2 class="font-display text-2xl font-bold uppercase tracking-tight text-balance text-foreground md:text-3xl">
			Let's build something
			<span class="text-glow-cyan text-accent">electric</span>
			.
		</h2>
		<p class="mt-3 max-w-md text-pretty leading-relaxed text-muted-foreground">
			Open to freelance, collaborations, and the occasional late-night
			side project. Reach out on any channel below.
		</p>

		<div class="mt-6 flex flex-wrap gap-6">
			{
				CHANNELS.map((ch) => {
					const Inner = (
						<>
							<div class="flex items-center gap-2">
								<ch.Icon class="size-4 text-muted-foreground" />
								<span class="font-mono text-xs uppercase tracking-widest text-muted-foreground">{ch.label}</span>
							</div>
							<span class="font-mono text-xs text-foreground">{ch.handle}</span>
						</>
					);
					if (ch.href.length === 0) {
						return <div class="group flex flex-col gap-1.5">{Inner}</div>;
					}
					return (
						<a href={ch.href} target="_blank" rel="noreferrer" class="group flex flex-col gap-1.5">
							{Inner}
						</a>
					);
				})
			}
		</div>
	</div>
</section>
