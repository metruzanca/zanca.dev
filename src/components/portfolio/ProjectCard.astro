---
import type { GithubRepo } from '../../data/github';
import { GitBranch } from '../ui/icons/index';
import { formatMonthYear } from '../../utils/datetime';

interface Props {
	repo: GithubRepo;
}

const { repo } = Astro.props;

function tagAccent(index: number): string {
	return index % 2 === 0 ? 'primary' : 'cyan';
}

function tagClasses(accent: string): string {
	return accent === 'cyan'
		? 'rounded-md border px-2 py-0.5 font-mono text-[0.7rem] border-accent/40 text-accent'
		: 'rounded-md border px-2 py-0.5 font-mono text-[0.7rem] border-primary/40 text-primary';
}

const starCount = repo.stars >= 1000 ? `${(repo.stars / 1000).toFixed(1)}k` : String(repo.stars);
const tags = repo.topics.slice(0, 4);
---

<a
	href={repo.url}
	target="_blank"
	rel="noreferrer"
	class="group relative flex flex-col rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/50"
>
	{(repo.language || repo.stars > 0 || repo.commit_count > 0) && (
		<div class="mb-2 flex items-center justify-between gap-3">
			{repo.language ? (
				<div class="flex items-center gap-1.5">
					{repo.language_color && (
						<span class="inline-block size-2 rounded-full" style={`background-color: ${repo.language_color}`}></span>
					)}
					<span class="font-mono text-[0.7rem] uppercase tracking-wider text-muted-foreground">{repo.language}</span>
				</div>
			) : (
				<span></span>
			)}
			<span class="inline-flex items-center gap-2 font-mono text-xs text-muted-foreground">
				{repo.stars > 0 && (
					<span class="inline-flex items-center gap-1">
						<span class="text-primary">★</span>
						{starCount}
					</span>
				)}
				{repo.commit_count > 0 && (
					<span class="inline-flex items-center gap-1">
						<GitBranch class="size-3.5" />
						{repo.commit_count}
					</span>
				)}
			</span>
		</div>
	)}
	<div class="flex items-start justify-between gap-3">
		<h3 class="font-display text-lg font-bold uppercase tracking-tight text-foreground transition-colors group-hover:underline">
			{repo.name}
		</h3>
	</div>

	{repo.description.length > 0 && (
		<p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{repo.description}</p>
	)}

	<div class="mt-4 flex items-center justify-between gap-3">
		<div class="flex flex-wrap gap-1.5">
			{tags.map((tag, i) => (
				<span class={tagClasses(tagAccent(i))}>{tag}</span>
			))}
		</div>
		{repo.committed_date && (
			<span class="whitespace-nowrap font-mono text-[0.65rem] text-muted-foreground/60">
				{formatMonthYear(repo.committed_date)}
			</span>
		)}
	</div>
</a>
