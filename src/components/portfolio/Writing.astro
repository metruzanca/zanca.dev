---
import { getMergedPosts } from '../../data/blog';
import WritingItem from './WritingItem.astro';

const posts = getMergedPosts().slice(0, 4);
---

<section id="writing" class="px-4 py-12">
	<div class="mb-6 flex items-center justify-end border-b border-border pb-2">
		<a href="/blog" class="font-mono text-xs text-muted-foreground transition-colors hover:text-glow-cyan hover:text-accent">
			view all →
		</a>
	</div>

	<ul class="flex flex-col">
		{posts.map((post) => <WritingItem post={post} />)}
	</ul>
</section>
