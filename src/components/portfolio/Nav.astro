---
import { GitBranch, X, BlueSky } from '../ui/icons/index';
---

<header class="sticky top-0 z-30 border-b border-border bg-background/80 backdrop-blur-md">
		<div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3">
			<a href="/" class="flex items-center gap-2 font-mono text-sm text-foreground">
				<span class="inline-block size-2 rounded-full bg-primary shadow-glow-pink"></span>
				<span class="font-semibold font-display">SAM</span>
			</a>

			<nav class="hidden items-center gap-1 sm:flex" aria-label="Primary">
				<a href="/" class="rounded-md px-2 py-1 font-mono text-xs text-muted-foreground transition-colors hover:text-accent hover:text-glow-cyan">/home</a>
				<a href="/about" class="rounded-md px-2 py-1 font-mono text-xs text-muted-foreground transition-colors hover:text-accent hover:text-glow-cyan">/about</a>
				<a href="/projects" class="rounded-md px-2 py-1 font-mono text-xs text-muted-foreground transition-colors hover:text-accent hover:text-glow-cyan">/projects</a>
				<a href="/blog" class="rounded-md px-2 py-1 font-mono text-xs text-muted-foreground transition-colors hover:text-accent hover:text-glow-cyan">/blog</a>

				<div class="relative" data-nav-more>
					<button
						type="button"
						class="flex items-center gap-0.5 rounded-md px-2 py-1 font-mono text-xs text-muted-foreground transition-colors hover:text-accent hover:text-glow-cyan"
						data-nav-more-toggle
					>
						/more
						<span class="text-[10px] opacity-60">▾</span>
					</button>
					<div
						class="absolute right-0 top-full z-20 mt-1 hidden min-w-[120px] rounded-lg border border-border bg-card p-1 shadow-lg"
						data-nav-more-menu
					>
						<a href="/how-i-work" class="block rounded-md px-3 py-2 font-mono text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">/how-i-work</a>
						<a href="/labs" class="block rounded-md px-3 py-2 font-mono text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">/labs</a>
						<a href="/resume" class="block rounded-md px-3 py-2 font-mono text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">/resume</a>
						<a href="/music" class="block rounded-md px-3 py-2 font-mono text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">/music</a>
					</div>
				</div>
			</nav>

			<div class="hidden items-center gap-1 sm:flex">
				<a href="https://github.com/metruzanca" target="_blank" rel="noreferrer" aria-label="GitHub" class="rounded-md p-1.5 text-muted-foreground transition-colors hover:text-primary">
					<GitBranch class="size-4" />
				</a>
				<a href="https://x.com/metruzanca" target="_blank" rel="noreferrer" aria-label="X / Twitter" class="rounded-md p-1.5 text-muted-foreground transition-colors hover:text-primary">
					<X class="size-4" />
				</a>
				<a href="https://bsky.app/profile/metru.dev" target="_blank" rel="noreferrer" aria-label="BlueSky" class="rounded-md p-1.5 text-muted-foreground transition-colors hover:text-primary">
					<BlueSky class="size-4" />
				</a>
			</div>

			<button
				type="button"
				class="flex items-center rounded-md p-2 text-muted-foreground transition-colors hover:text-primary sm:hidden"
				aria-label="Menu"
				data-nav-mobile-toggle
			>
				<svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
					<line x1="4" y1="6" x2="20" y2="6"></line>
					<line x1="4" y1="12" x2="20" y2="12"></line>
					<line x1="4" y1="18" x2="20" y2="18"></line>
				</svg>
			</button>
		</div>
	</header>

	<div class="fixed inset-0 z-40 hidden sm:hidden" data-nav-mobile>
		<div class="absolute inset-0 bg-black/60 backdrop-blur-sm" data-nav-mobile-close></div>
		<div class="absolute right-0 top-0 z-50 h-full w-64 border-l border-border bg-background p-6">
			<div class="flex justify-end">
				<button type="button" class="rounded-md p-2 text-muted-foreground transition-colors hover:text-primary" aria-label="Close menu" data-nav-mobile-close>
					<svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
			<nav class="mt-6 flex flex-col gap-1">
				<a href="/" class="rounded-md px-3 py-2 font-mono text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">/home</a>
				<a href="/about" class="rounded-md px-3 py-2 font-mono text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">/about</a>
				<a href="/how-i-work" class="rounded-md px-3 py-2 font-mono text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">/how-i-work</a>
				<a href="/projects" class="rounded-md px-3 py-2 font-mono text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">/projects</a>
				<a href="/blog" class="rounded-md px-3 py-2 font-mono text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">/blog</a>
				<a href="/labs" class="rounded-md px-3 py-2 font-mono text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">/labs</a>
				<a href="/resume" class="rounded-md px-3 py-2 font-mono text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">/resume</a>
				<a href="/music" class="rounded-md px-3 py-2 font-mono text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">/music</a>
			</nav>
			<div class="mt-6 flex items-center gap-2 border-t border-border pt-4">
				<a href="https://github.com/metruzanca" target="_blank" rel="noreferrer" aria-label="GitHub" class="rounded-md p-1.5 text-muted-foreground transition-colors hover:text-primary">
					<GitBranch class="size-4" />
				</a>
				<a href="https://x.com/metruzanca" target="_blank" rel="noreferrer" aria-label="X / Twitter" class="rounded-md p-1.5 text-muted-foreground transition-colors hover:text-primary">
					<X class="size-4" />
				</a>
				<a href="https://bsky.app/profile/metru.dev" target="_blank" rel="noreferrer" aria-label="BlueSky" class="rounded-md p-1.5 text-muted-foreground transition-colors hover:text-primary">
					<BlueSky class="size-4" />
				</a>
			</div>
		</div>
	</div>

	<slot />

<script>
	const moreToggle = document.querySelector<HTMLButtonElement>('[data-nav-more-toggle]');
	const moreMenu = document.querySelector<HTMLElement>('[data-nav-more-menu]');
	const mobileToggle = document.querySelector<HTMLButtonElement>('[data-nav-mobile-toggle]');
	const mobileDrawer = document.querySelector<HTMLElement>('[data-nav-mobile]');
	const mobileCloseButtons = document.querySelectorAll<HTMLElement>('[data-nav-mobile-close]');

	moreToggle?.addEventListener('click', (e) => {
		e.stopPropagation();
		moreMenu?.classList.toggle('hidden');
	});

	mobileToggle?.addEventListener('click', () => {
		mobileDrawer?.classList.remove('hidden');
	});

	mobileCloseButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			mobileDrawer?.classList.add('hidden');
		});
	});

	document.addEventListener('click', (e) => {
		if (moreMenu && !moreMenu.classList.contains('hidden')) {
			const target = e.target as HTMLElement;
			if (!target.closest('[data-nav-more]')) {
				moreMenu.classList.add('hidden');
			}
		}
	});
</script>
