---
import { allProjects } from '../../data/projects';
import CaseStudyCard from './CaseStudyCard.astro';

const all = allProjects();
const recent = all.slice(0, 3);
---

{
	all.length > 0 && (
		<section id="case-studies" class="px-4 py-12">
			<div class="mb-6 flex items-center justify-end border-b border-border pb-2">
				<a href="/projects" class="font-mono text-xs text-muted-foreground transition-colors hover:text-glow-cyan hover:text-accent">
					view all →
				</a>
			</div>

			<div class="grid grid-cols-1 gap-4">
				{recent.map((project) => <CaseStudyCard project={project} />)}
			</div>
		</section>
	)
}
