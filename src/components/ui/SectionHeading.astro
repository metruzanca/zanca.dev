---
interface Props {
	id: string;
	eyebrow: string;
	title: string;
	description: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<div id={id} class="scroll-mt-20">
	<p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">{eyebrow}</p>
	<h2 class="mt-2 font-display text-2xl font-bold uppercase tracking-tight text-foreground md:text-3xl">{title}</h2>
	<p class="mt-2 max-w-2xl text-pretty leading-relaxed text-muted-foreground">{description}</p>
</div>
